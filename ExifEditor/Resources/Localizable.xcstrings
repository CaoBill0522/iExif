    },
    "The originals were kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原图已保留。"
          }
        }
      }
    },
    "The originals were moved to Recently Deleted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原图已移到“最近删除”。"
          }
        }
      }
    },
    "The photo will be enlarged and may look blurry.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片会被放大，可能显得模糊。"
