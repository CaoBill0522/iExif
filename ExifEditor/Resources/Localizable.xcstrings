      }
    },
    "The edited photo was saved. The original was kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改后的照片已保存，原图已保留。"
          }
        }
      }
    },
    "The image will be re-encoded at %lld%% quality to change its format or size.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为转换格式或调整尺寸，图像将以 %lld%% 质量重新编码。"
          }
        }
      }
    },
    "The original format is kept unless the chosen device couldn't have taken it, such as HEIC on an iPhone 6s or any PNG.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持原格式，除非所选机型不可能拍出这种格式，例如 iPhone 6s 的 HEIC 或任何 PNG。"
          }
        }
      }
    },
    "The original photo can no longer be found in your library.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相册中已找不到原照片。"
          }
        }
      }
    },
    "The original photo is kept.": {
      "localizations": {
