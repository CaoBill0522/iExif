{
  "sourceLanguage": "en",
  "strings": {
    "": {
      "shouldTranslate": false
    },
    "%lld Photos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 张照片"
          }
        }
      }
    },
    "%lld items": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 项"
          }
        }
      }
    },
    "%lld items aren't supported images or couldn't be downloaded from iCloud.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 项不是支持的图片格式，或无法从 iCloud 下载。"
          }
        }
      }
    },
    "%lld photos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 张照片"
          }
        }
      }
    },
    "%lld photos were saved to your library.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将 %lld 张照片保存到相册。"
          }
        }
      }
    },
    "%lld photos were saved; %lld failed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存 %lld 张照片，%lld 张失败。"
          }
        }
      }
    },
    "1/120": {
      "shouldTranslate": false
    },
    "35mm Equivalent": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等效焦距"
          }
        }
      }
    },
    "96 devices, from iPhone 4 to the latest models": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "96 款设备，从 iPhone 4 到最新机型"
          }
        }
      }
    },
    "A little of the edges will be cropped to match the camera's aspect ratio.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会从边缘裁掉少量画面，以符合相机的画面比例。"
          }
        }
      }
    },
    "Add Date Taken": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加拍摄时间"
          }
        }
      }
    },
    "Add Location": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加位置"
          }
        }
      }
    },
    "Albums": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相簿"
          }
        }
      }
    },
    "All photos are processed on your device. Nothing is uploaded.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有照片都在本机处理，不会上传任何数据。"
          }
        }
      }
    },
    "Allow access to your photo library in Settings to browse and edit your photos. You can still import from Files.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许访问相册，以浏览和编辑照片。你仍然可以从“文件”导入。"
          }
        }
      }
    },
    "Allow location access in Settings to use your current location.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许访问位置，以使用当前位置。"
          }
        }
      }
    },
    "Altitude": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "海拔"
          }
        }
      }
    },
    "Aperture": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光圈"
          }
        }
