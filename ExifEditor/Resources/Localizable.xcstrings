          }
        }
      }
    },
    "WGS-84 decimal degrees, as used by GPS and EXIF. South and west are negative.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WGS-84 十进制度数，即 GPS 与 EXIF 使用的坐标。南纬、西经为负数。"
