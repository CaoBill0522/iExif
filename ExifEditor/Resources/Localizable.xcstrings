    "Changed fields: %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已修改 %lld 项"
          }
        }
      }
    },
    "Changes make, model and software only; lens fields stay the same.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只修改品牌、型号和系统版本，镜头信息保持不变。"
          }
        }
      }
    },
    "Changes only what the Photos app shows, without creating a new photo. The EXIF inside the file stays unchanged.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只修改“照片”App 中显示的信息，不生成新照片，文件内的 EXIF 保持不变。"
          }
        }
      }
    },
    "Choose from Presets": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从预设选择"
          }
        }
      }
    },
    "Choose from presets for every iPhone and iPad camera. Make, model, lens, aperture and focal length are filled in for you.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从全部 iPhone 和 iPad 的镜头预设中选择，品牌、型号、镜头、光圈和焦距会自动填好。"
          }
        }
      }
    },
