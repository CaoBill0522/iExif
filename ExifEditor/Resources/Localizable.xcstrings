            "state": "translated",
            "value": "长按预览"
          }
        }
      }
    },
    "Turn on the fields to change. Fields that are off keep each photo's own values. Initial values come from the first photo.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开需要修改的字段，未打开的字段保留每张照片原来的值。初始值取自第一张照片。"
          }
        }
      }
